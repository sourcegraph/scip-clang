{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>sourcegraph/renovate-config"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": [
    "before 9am on monday"
  ],
  "packageRules": [
    {
      "description": "Merge non-major updates once the required Buildkite check passes; major updates need review.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Stay on the Ubuntu LTS before the newest one; move to 26.04 when 28.04 is released.",
      "matchDatasources": [
        "docker",
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^24\\.04$/"
    },
    {
      "description": "Update all platform binaries of a tool in one PR.",
      "matchDepNames": [
        "/^buildifier_/"
      ],
      "groupName": "buildifier"
    },
    {
      "matchDepNames": [
        "/^actionlint_/"
      ],
      "groupName": "actionlint"
    },
    {
      "description": "Update the Python formatting tools together so their pins stay compatible.",
      "matchFileNames": [
        "tools/requirements_lock.txt"
      ],
      "groupName": "Python tooling"
    },
    {
      "description": "Wait a week before adopting a new action release, so a compromised release is likely pulled first.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "minimumReleaseAge": "7 days"
    }
  ]
}
